+class NoiseFrameDecoder:
+    """Bounded reassembly matching the Muse web client's Noise framing."""
+
+    def __init__(self):
+        self.pending = {}
+
+    def decode(self, data):
+        frame = NoiseTransportFrame()
+        frame.ParseFromString(data)
+        total = frame.total_chunks if frame.HasField('total_chunks') else 1
+        index = frame.chunk_index
+        if not 1 <= total <= NOISE_MAX_CHUNKS or not 0 <= index < total:
+            raise GatewayError(-1, 'invalid Noise chunk metadata')
+        if len(frame.payload) > NOISE_CHUNK_BYTES:
+            raise GatewayError(-1, 'Noise chunk payload exceeds limit')
+        now = time.monotonic()
+        if any(now - item['created'] > 30 for item in self.pending.values()):
+            raise GatewayError(-1, 'Noise chunk assembly expired')
+        key = frame.chunk_id
+        if key not in self.pending:
+            if len(self.pending) >= 16:
+                raise GatewayError(-1, 'too many pending Noise assemblies')
+            self.pending[key] = {'total': total, 'chunks': {}, 'created': now}
+        item = self.pending[key]
+        if item['total'] != total or index in item['chunks']:
+            raise GatewayError(-1, 'inconsistent or duplicate Noise chunk')
+        item['chunks'][index] = bytes(frame.payload)
+        if len(item['chunks']) < total:
+            return None
+        del self.pending[key]
+        return b''.join(item['chunks'][i] for i in range(total))
 
 
