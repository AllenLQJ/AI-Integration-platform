+++ b/tests/test_noise_framing.py
@@ -0,0 +1,69 @@
+import threading
+import unittest
+from types import SimpleNamespace
+from muse import (Gateway, GatewayError, NoiseFrameDecoder, NoiseTransportFrame,
+                  ServiceRequest, NOISE_CHUNK_BYTES)
+
+
+class NoiseFramingTests(unittest.TestCase):
+    def frames(self, payload):
+        sent = []
+        def encrypt(data):
+            # Include the AES-GCM tag in the Noise wire message limit.
+            self.assertLessEqual(len(data) + 16, 65535)
+            return data
+        gateway = Gateway.__new__(Gateway)
+        gateway._send_lock = threading.Lock()
+        gateway.ws = SimpleNamespace(send_bytes=sent.append)
+        gateway.noise = SimpleNamespace(encrypt=encrypt)
+        gateway._send_envelope(0, payload)
+        return sent
+
+    def test_long_request_round_trip_and_chunk_order(self):
+        payload = ('长文档内容' * 20000).encode()
+        frames = self.frames(payload)
+        self.assertGreater(len(frames), 1)
+        decoder = NoiseFrameDecoder()
+        decoded = None
+        chunk_ids = set()
+        for index, data in enumerate(frames):
+            frame = NoiseTransportFrame.FromString(data)
+            chunk_ids.add(frame.chunk_id)
+            self.assertEqual(frame.chunk_index, index)
+            self.assertEqual(frame.total_chunks, len(frames))
+            decoded = decoder.decode(data)
+            if index < len(frames) - 1:
+                self.assertIsNone(decoded)
+        self.assertEqual(len(chunk_ids), 1)
+        self.assertEqual(ServiceRequest.FromString(decoded).payload, payload)
+        self.assertEqual(decoder.pending, {})
+
+    def test_boundary_and_small_requests(self):
+        for size in (0, 1, NOISE_CHUNK_BYTES - 5, NOISE_CHUNK_BYTES, 98052):
+            with self.subTest(size=size):
+                decoder = NoiseFrameDecoder()
+                for frame in self.frames(b'x' * size):
+                    decoded = decoder.decode(frame)
+                self.assertEqual(ServiceRequest.FromString(decoded).payload, b'x' * size)
+
+    def test_reordered_chunks_are_reassembled(self):
+        decoder = NoiseFrameDecoder()
+        payload = b'x' * 150000
+        for frame in reversed(self.frames(payload)):
+            decoded = decoder.decode(frame)
+        self.assertEqual(ServiceRequest.FromString(decoded).payload, payload)
+
+    def test_duplicate_chunk_is_rejected(self):
+        decoder = NoiseFrameDecoder()
+        frame = self.frames(b'x' * 150000)[0]
+        self.assertIsNone(decoder.decode(frame))
+        with self.assertRaises(GatewayError):
+            decoder.decode(frame)
+
+    def test_oversized_request_is_rejected_before_send(self):
+        with self.assertRaises(ValueError):
+            self.frames(b'x' * (NOISE_CHUNK_BYTES * 256))
+
+
+if __name__ == '__main__':
+    unittest.main()
