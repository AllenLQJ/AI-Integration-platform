+++ b/tests/test_gateway_reuse.py
@@ -0,0 +1,92 @@
+import tempfile
+import unittest
+import threading
+import time
+from pathlib import Path
+from unittest.mock import Mock
+
+from muse import GatewayError
+from muse_mcp.client import MuseClient
+
+
+class GatewayReuseTests(unittest.TestCase):
+    def setUp(self):
+        self.root = tempfile.TemporaryDirectory()
+        self.cookie = Path(self.root.name) / "cookies.txt"
+        self.cookie.write_text("hatch_sess=test; other=test")
+        self.gateway = Mock()
+        self.gateway.call_json.return_value = {"chat_events": []}
+        self.factory = Mock(return_value=self.gateway)
+
+    def tearDown(self):
+        self.root.cleanup()
+
+    def client(self):
+        return MuseClient(config_loader=lambda: {"cookies_file": str(self.cookie), "node_id": "test-node"},
+                          gateway_factory=self.factory, reuse_gateway=True)
+
+    def test_sequential_reads_reuse_connection_and_explicit_close(self):
+        client = self.client()
+        self.assertEqual(client.history(), [])
+        self.assertEqual(client.history(), [])
+        self.assertEqual(self.factory.call_count, 1)
+        self.gateway.close.assert_not_called()
+        client.close()
+        self.gateway.close.assert_called_once()
+
+    def test_failure_discards_connection_without_replaying_operation(self):
+        client = self.client()
+        self.gateway.call_json.side_effect = [GatewayError(500, "test"), {"chat_events": []}]
+        self.assertFalse(client.history()["ok"])
+        self.assertEqual(self.gateway.call_json.call_count, 1)
+        self.gateway.close.assert_called_once()
+        self.assertEqual(client.history(), [])
+        self.assertEqual(self.factory.call_count, 2)
+        client.close()
+
+    def test_default_still_closes_each_connection(self):
+        client = MuseClient(config_loader=lambda: {"cookies_file": str(self.cookie)}, gateway_factory=self.factory)
+        client.history()
+        client.history()
+        self.assertEqual(self.factory.call_count, 2)
+        self.assertEqual(self.gateway.close.call_count, 2)
+
+    def test_cookie_change_discards_old_connection(self):
+        client = self.client()
+        client.history()
+        self.cookie.write_text("hatch_sess=changed; other=test")
+        client.history()
+        self.assertEqual(self.factory.call_count, 2)
+        self.gateway.close.assert_called_once()
+        client.close()
+
+    def test_mutation_failure_is_not_replayed(self):
+        client = self.client()
+        self.gateway._open.side_effect = GatewayError(500, "test")
+        result = client.send("test", fire_and_forget=True)
+        self.assertFalse(result["ok"])
+        self.gateway._open.assert_called_once()
+        self.assertEqual(self.factory.call_count, 1)
+        self.gateway.close.assert_called_once()
+        client.close()
+        self.gateway.close.assert_called_once()
+
+    def test_concurrent_calls_have_one_consumer(self):
+        client = self.client()
+        active = maximum = 0
+        def operation(*args, **kwargs):
+            nonlocal active, maximum
+            active += 1
+            maximum = max(maximum, active)
+            time.sleep(0.02)
+            active -= 1
+            return {"chat_events": []}
+        self.gateway.call_json.side_effect = operation
+        threads = [threading.Thread(target=client.history) for _ in range(3)]
+        for thread in threads: thread.start()
+        for thread in threads: thread.join(2)
+        self.assertTrue(all(not thread.is_alive() for thread in threads))
+        self.assertEqual(self.gateway.call_json.call_count, 3)
+        self.assertEqual(maximum, 1)
+        self.assertEqual(self.factory.call_count, 1)
+        client.close()
