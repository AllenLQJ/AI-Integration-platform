+++ b/tests/test_https_recovery.py
@@ -0,0 +1,53 @@
+import unittest
+from unittest.mock import Mock, patch
+
+from curl_cffi.requests.exceptions import SSLError
+import muse
+
+
+class HTTPSRecoveryTests(unittest.TestCase):
+    def test_session_recovers_transient_tls_failure(self):
+        response = Mock(status_code=200)
+        response.json.return_value = {"vm_id": "test-vm"}
+        with patch.object(muse.rq, "get", side_effect=[SSLError("private", code=35), response]) as request, patch.object(muse.time, "sleep"):
+            self.assertEqual(muse.fetch_session_info("test-cookie"), {"vm_id": "test-vm"})
+            self.assertEqual(request.call_count, 2)
+            self.assertNotIn("verify", request.call_args.kwargs)
+
+    def test_tls_retry_is_bounded(self):
+        with patch.object(muse.rq, "get", side_effect=SSLError("private", code=35)) as request, patch.object(muse.time, "sleep") as sleep:
+            with self.assertRaises(SSLError):
+                muse.fetch_session_info("test-cookie")
+            self.assertEqual(request.call_count, 3)
+            self.assertEqual([call.args[0] for call in sleep.call_args_list], [0.5, 1.0])
+
+    def test_certificate_failure_is_not_retried(self):
+        with patch.object(muse.rq, "get", side_effect=SSLError("private", code=60)) as request:
+            with self.assertRaises(SSLError):
+                muse.fetch_session_info("test-cookie")
+            self.assertEqual(request.call_count, 1)
+
+    def test_authentication_posts_recover_and_preserve_arguments(self):
+        for operation, payload, expected in [
+            (lambda: muse.fetch_access_token("test-cookie"), {"access_token": "test-access"}, "test-access"),
+            (lambda: muse.fetch_hatch_token("test-cookie", "test-access", "test-vm"), {"token": "test-hatch"}, "test-hatch"),
+        ]:
+            response = Mock(status_code=200)
+            response.json.return_value = payload
+            with patch.object(muse.rq, "post", side_effect=[SSLError("private", code=35), response]) as request, patch.object(muse.time, "sleep"):
+                self.assertEqual(operation(), expected)
+                self.assertEqual(request.call_count, 2)
+                self.assertEqual(request.call_args_list[0], request.call_args_list[1])
+                self.assertNotIn("verify", request.call_args.kwargs)
+
+    def test_unrelated_error_is_not_retried(self):
+        with patch.object(muse.rq, "get", side_effect=ValueError("bad response")) as request:
+            with self.assertRaises(ValueError):
+                muse.fetch_session_info("test-cookie")
+            self.assertEqual(request.call_count, 1)
+
+    def test_auth_rejection_is_not_retried(self):
+        with patch.object(muse.rq, "get", return_value=Mock(status_code=401)) as request:
+            with self.assertRaises(muse.AuthError):
+                muse.fetch_session_info("test-cookie")
+            self.assertEqual(request.call_count, 1)
