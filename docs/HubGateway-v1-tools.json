      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "after_seq": {
          "default": 0,
          "title": "After Seq",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "get_eventsArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "wait_for_task",
    "description": "等待终态、waiting_for_user 或单次超时（0–10 秒）；超时不取消任务。\n\n    用 next_seq 续接，has_more=true 时继续取事件；响应丢失按 seq 去重。\n    终态后调用 get_result 获取回答。needs_user=true 时停止轮询并提示用户接管 Muse；\n    用户确认处理完成后调用 resume_task，保留原任务，不能重复提交或调用 continue_task。\n    ",
    "inputSchema": {
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "after_seq": {
          "default": 0,
          "title": "After Seq",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 10,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "wait_for_taskArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_result",
    "description": "获取完成结果与差异；未完成返回 ready=false。",
    "inputSchema": {
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "get_resultArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "continue_task",
    "description": "续接原生会话并创建子任务，保留旧结果和同一工作区。",
    "inputSchema": {
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 1800,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "prompt"
      ],
      "title": "continue_taskArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "cancel_task",
    "description": "请求取消；Grok Bot 尝试会话中断，get_result 确认 remote_cancelled。\n    Muse 同样尝试原会话中断；SSH 执行器取消原目标机任务。已发生操作不自动回滚。\n    ",
    "inputSchema": {
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "reason": {
          "default": "用户取消",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "cancel_taskArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
