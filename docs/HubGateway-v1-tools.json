      "title": "get_taskArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_events",
    "description": "按游标读取任务事件，上限 200 条。",
