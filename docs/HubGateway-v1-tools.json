  {
    "name": "resume_task",
    "description": "仅在用户明确确认人工验证/登录/审批已处理后调用；恢复原 Muse 任务。\n\n    intervention_id 来自 get_task/wait_for_task 的 intervention；同一介入只恢复一次。\n    不代替用户完成验证，不创建新任务；确认后继续查询原 task_id。\n    ",
    "inputSchema": {
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "intervention_id": {
          "title": "Intervention Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "intervention_id"
      ],
      "title": "resume_taskArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
