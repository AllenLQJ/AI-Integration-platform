  {
    "name": "submit_task",
    "description": "提交后台任务并立即返回 ID。同一个 request_id 和内容幂等。\n\n    Claude: text_only/read_only/edit_worktree；Codex、Cursor: read_only/edit_worktree。\n    Muse、Grok Bot 仅 delegate，Hub 不保证其只读，权限由远端/客户端决定。\n    permissions 返回限制执行方及允许写入等信息。",
    "inputSchema": {
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "cwd": {
          "title": "Cwd",
          "type": "string"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 1800,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "context": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        }
      },
      "required": [
        "request_id",
        "agent",
        "prompt",
        "cwd",
        "mode"
      ],
      "title": "submit_taskArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_task",
